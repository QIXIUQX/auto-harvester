{
	"schemaVersion": 1,
	"id": "auto-harvester",
	"version": "${version}",
	"name": "Auto Harvester（自动收割机）",
	"description": "添加自动收割机方块：每 20 tick 扫描朝向一侧 9×9 区域，自动收割成熟作物并补种，产物依次存入背面/左侧/右侧的容器。",
	"authors": [
		"shiguang"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/QIXIUQX/auto-harvester"
	},
	"license": "MIT",
	"icon": "assets/auto-harvester/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.shiguang.AutoHarvester"
		],
		"client": [
			"com.shiguang.client.AutoHarvesterClient"
		],
		"fabric-datagen": [
			"com.shiguang.client.AutoHarvesterDataGenerator"
		]
	},
	"mixins": [
		"auto-harvester.mixins.json",
		{
			"config": "auto-harvester.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}